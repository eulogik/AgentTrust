{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentTrust",
          "version": "0.1.0",
          "informationUri": "https://agenttrust.dev",
          "rules": [
            {
              "id": "AT-SEC-003",
              "name": "Unbounded Dynamic Shell Execution",
              "shortDescription": {
                "text": "Unbounded Dynamic Shell Execution"
              },
              "fullDescription": {
                "text": "The agent executes shell commands directly from dynamic parameters, allowing remote arbitrary command injection."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://agenttrust.dev/rules/AT-SEC-003"
            },
            {
              "id": "AT-SEC-005",
              "name": "Unrestricted Recursive File Deletion / Modification",
              "shortDescription": {
                "text": "Unrestricted Recursive File Deletion / Modification"
              },
              "fullDescription": {
                "text": "Capability can delete or overwrite arbitrary files on the host filesystem without path validation or human confirmation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://agenttrust.dev/rules/AT-SEC-005"
            },
            {
              "id": "AT-SEC-007",
              "name": "Raw Secret Leakage in Debug Logging",
              "shortDescription": {
                "text": "Raw Secret Leakage in Debug Logging"
              },
              "fullDescription": {
                "text": "Console or file logging dumps raw tokens, authorization headers, or environment objects."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://agenttrust.dev/rules/AT-SEC-007"
            },
            {
              "id": "AT-COMP-001",
              "name": "Missing Human-in-the-Loop Gate for Critical Actions",
              "shortDescription": {
                "text": "Missing Human-in-the-Loop Gate for Critical Actions"
              },
              "fullDescription": {
                "text": "Irreversible actions (e.g. database wipe, financial transaction, email dispatch) execute autonomously with no approval trigger."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://agenttrust.dev/rules/AT-COMP-001"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AT-SEC-003",
          "level": "error",
          "message": {
            "text": "Unbounded Dynamic Shell Execution: The agent executes shell commands directly from dynamic parameters, allowing remote arbitrary command injection."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.ts"
                },
                "region": {
                  "startLine": 16
                }
              }
            }
          ]
        },
        {
          "ruleId": "AT-SEC-005",
          "level": "error",
          "message": {
            "text": "Unrestricted Recursive File Deletion / Modification: Capability can delete or overwrite arbitrary files on the host filesystem without path validation or human confirmation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.ts"
                },
                "region": {
                  "startLine": 31
                }
              }
            }
          ]
        },
        {
          "ruleId": "AT-SEC-007",
          "level": "warning",
          "message": {
            "text": "Raw Secret Leakage in Debug Logging: Console or file logging dumps raw tokens, authorization headers, or environment objects."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.ts"
                },
                "region": {
                  "startLine": 25
                }
              }
            }
          ]
        },
        {
          "ruleId": "AT-COMP-001",
          "level": "error",
          "message": {
            "text": "Missing Human-in-the-Loop Gate for Critical Actions: Irreversible actions (e.g. database wipe, financial transaction, email dispatch) execute autonomously with no approval trigger."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}