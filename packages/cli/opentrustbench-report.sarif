{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "OpenTrustBench",
          "version": "0.1.1",
          "informationUri": "https://www.opentrustbench.com",
          "rules": [
            {
              "id": "AT-SEC-006",
              "name": "Unfiltered SSRF / Arbitrary Network Egress",
              "shortDescription": {
                "text": "Unfiltered SSRF / Arbitrary Network Egress"
              },
              "fullDescription": {
                "text": "Network requests accept arbitrary external URLs from agent or user input without host allowlisting."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/eulogik/OpenTrustBench#readme"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AT-SEC-006",
          "level": "error",
          "message": {
            "text": "Unfiltered SSRF / Arbitrary Network Egress: Network requests accept arbitrary external URLs from agent or user input without host allowlisting."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scrapers/india_scraper.py"
                },
                "region": {
                  "startLine": 35
                }
              }
            }
          ]
        },
        {
          "ruleId": "AT-SEC-006",
          "level": "error",
          "message": {
